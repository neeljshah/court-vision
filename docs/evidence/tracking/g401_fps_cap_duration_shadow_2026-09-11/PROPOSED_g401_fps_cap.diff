+def duration_frame_cap(source: dict | None) -> tuple[int, str]:
+    """The source-frame cap that buys TARGET_DURATION_SECONDS, or the legacy cap.
+
+     is the dict probe_source() already builds for every job; no extra
+    probe is added. A missing, failed or non-positive rate keeps 3000 frames.
+    """
+    rate = (source or {}).get("source_fps")
+    if probe_status(source) != "ok" or not isinstance(rate, (int, float)):
+        return LEGACY_FRAME_CAP, "UNKNOWN"
+    if not math.isfinite(rate) or rate <= 0:
+        return LEGACY_FRAME_CAP, "UNKNOWN"
+    return int(math.ceil(TARGET_DURATION_SECONDS * rate)), "VALIDATED_FPS"
+
+
+def cap_receipt(source: dict | None) -> dict:
