# =============================================================================
# CourtVision -- .gitignore
# =============================================================================

# -- Large Binaries / Video ---------------------------------------------------
data/videos/
*.mp4
*.avi
*.mov
*.mkv

# -- YOLO / Model Weights -----------------------------------------------------
*.pt
*.onnx
*.engine
*.trt
*.pth
models/weights/

# -- Trained model artifacts (large; re-trained locally) ----------------------
data/models/
!data/models/.gitkeep
!data/models/model_registry.json
!data/models/win_prob_metrics.json
!data/models/live_win_prob_metrics.json
!data/models/game_models_metrics.json
!data/models/hyperparams_*.json
!data/models/prop_corr_matrix.json
!data/models/props_stl_v2_metrics.json
!data/models/matchup_model_meta.json
!data/models/dnp_model_meta.json
!data/models/probe_defender_feature.json
!data/models/bet_log.json
!data/models/load_management.json

# -- NBA API data (fetched by ingest pipeline, not committed) -----------------
data/nba/

# -- CatBoost training logs (auto-created in CWD on every fit) ----------------
catboost_info/

# -- Python -------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.whl

# -- Secrets & Environment ----------------------------------------------------
.env
.env.local
.env.production
.env.staging
*.env
.venv/
venv/
env/
conda-env/

# -- IDE & Editor -------------------------------------------------------------
.vscode/
.windsurf/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# -- Runtime / Debug / Generated data -----------------------------------------
data/*.log
data/*.pid
data/*.txt
data/*.csv
data/*.json
data/chain_*.txt
!data/jersey_name_map.json
!data/team_colors.json

# -- R21_N5 m2_family prediction cache (per-machine runtime artifact) ---------
data/cache/m2_family_predictions_cache.json

# -- R27_T7 ledger insurance backups (machine-local; gzip+sidecar) ------------
data/backups/
data/backups_probe/
data/pnl_ledger.csv.pre_restore_*
data/output/
data/game_results/
data/props/
data/predictions/
data/live/
data/defender_matchups/
data/defender_matchups_*.parquet
data/defender_matchups_*.json
data/edges/
data/model_reports/
data/ball_yolo/
data/tracking_archive/
data/tracking/
data/games/
data/external/
data/fusion/
data/benchmarks/

# -- Resources (panoramas, calibration — generated by pipeline) ---------------
resources/
!resources/.gitkeep

# -- SQLite databases ---------------------------------------------------------
*.db
*.sqlite3

# -- Logs ---------------------------------------------------------------------
logs/
*.log

# -- Tests --------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.hypothesis/

# -- Jupyter ------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# -- Node / Frontend ----------------------------------------------------------
node_modules/
.next/
dist/
.nuxt/
.output/
.cache/

# -- Separate projects / nested repos -----------------------------------------
court-visions/
teflon-quant-dashboard/

# -- Model training runs (large artifacts, re-generable) ----------------------
models/
!src/models/
src/detection/data/images/

# -- Outreach / personal contact data (sensitive) -----------------------------
scripts/outreach/

# -- Knowledge base / planning (internal) -------------------------------------
vault/
.planning/

# -- Archive (safe-moved code) -------------------------------------------------
_archive/
legacy/

# -- Throwaway scripts --------------------------------------------------------
scripts/_*

