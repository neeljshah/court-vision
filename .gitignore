# =============================================================================
# CourtVision — .gitignore
# =============================================================================

# ── Large Binaries / Video ────────────────────────────────────────────────────
data/videos/
*.mp4
*.avi
*.mov
*.mkv

# YOLO / ONNX model weights (large binaries — store in Git LFS or cloud)
*.pt
*.onnx
*.engine
*.trt
models/weights/

# ── Python Cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/
pip-wheel-metadata/
*.whl

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.staging
*.env
conda-env/
.venv/
venv/
env/

# ── IDE & Editor ──────────────────────────────────────────────────────────────
.vscode/
.windsurf/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime / Debug Artifacts ─────────────────────────────────────────────────
data/frame_*.png
data/debug_*.png
data/tracking_check.png
run.log
data/game_loop_run.log
fps_before_after.txt

# ── Benchmark Reports (auto-generated, hundreds of files) ─────────────────────
data/benchmarks/report_*.json

# ── Runtime State & Logs ──────────────────────────────────────────────────────
data/*.log
data/*.jsonl
data/loop_*.json
data/smart_loop_log.jsonl
data/game_loop_results.json

# ── Claude / Windsurf Session State ───────────────────────────────────────────
.claude_session_changes.json
.claude/settings.local.json

# ── Test / Coverage Artifacts ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Node.js / Frontend Build Artifacts ────────────────────────────────────────
node_modules/
.next/
dist/
.nuxt/
.output/
.cache/

# ── Nested git repos (separate projects — not submodules) ─────────────────────
court-visions/
teflon-quant-dashboard/

# ── Legacy Code (superseded by src/) ──────────────────────────────────────────
legacy/

# ── Data — NBA API Cache (large, auto-refreshed) ──────────────────────────────
# These are auto-regenerated by scrapers and can be very large (100MB+).
data/nba/
data/external/

# ── Data — Generated game/tracking data (pipeline outputs) ────────────────────
data/tracking/
data/games/

# ── Archive (safe-moved files — never committed) ──────────────────────────────
_archive/

# ── Claude Worktrees (git feature — not project code) ─────────────────────────
.claude/worktrees/

# ── Cleanup script output ─────────────────────────────────────────────────────
cleanup.py

# ── Misc ──────────────────────────────────────────────────────────────────────
install_log.txt
pipeline_test.py
*.tmp
*.bak
*.orig
