# =============================================================================
# CourtVision -- .gitignore
# =============================================================================

# -- Large Binaries / Video ---------------------------------------------------
data/videos/
*.mp4
*.avi
*.mov
*.mkv

# -- YOLO / Model Weights -----------------------------------------------------
*.onnx
*.engine
*.trt
models/weights/
# Root YOLO weights are tracked (re-download via setup_dev.sh if missing)
!yolov8n.pt
!yolov8n-pose.pt

# -- Test fixture / placeholder PBP files -------------------------------------
data/nba/pbp_COMPLETEGAME*.json
data/nba/pbp_TESTGAME*.json
data/nba/pbp_None*.json
data/nba/pbp_atl_ind_2025*.json
data/nba/pbp_bos_mia_2025*.json

# -- Python -------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.whl

# -- Secrets & Environment ----------------------------------------------------
.env
.env.local
.env.production
.env.staging
*.env
.venv/
venv/
env/
conda-env/

# -- IDE & Editor -------------------------------------------------------------
.vscode/
.windsurf/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# -- Runtime / Debug ----------------------------------------------------------
data/*.log
data/*.pid
data/*.txt
data/chain_*.txt
data/output/
data/game_results/
data/props/
data/predictions/
data/edges/
data/model_reports/
data/ball_yolo/
data/tracking_archive/

# -- Generated CV / Tracking data (large, re-generated by pipeline) -----------
data/tracking/
data/games/
data/external/
resources/panos/
!resources/panos/.gitkeep

# -- SQLite databases ---------------------------------------------------------
*.db
*.sqlite3

# -- Logs ---------------------------------------------------------------------
logs/
*.log

# -- Tests --------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.hypothesis/

# -- Jupyter ------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# -- Node / Frontend ----------------------------------------------------------
node_modules/
.next/
dist/
.nuxt/
.output/
.cache/

# -- Separate projects / nested repos -----------------------------------------
court-visions/
teflon-quant-dashboard/

# -- Model training runs (large artifacts, re-generable) ----------------------
models/runs/
resources/*.pt

# -- Outreach / personal contact data (sensitive) -----------------------------
scripts/outreach/

# -- Knowledge base / planning (internal) -------------------------------------
vault/
.planning/

# -- Archive (safe-moved code) -------------------------------------------------
_archive/
legacy/

# -- Throwaway scripts --------------------------------------------------------
scripts/_*

# -- Claude / RunPod / MCP session state --------------------------------------
.runpod
.mcp.json
.claude_session_changes.json
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# -- Benchmark / Diagnostic outputs -------------------------------------------
data/benchmarks/report_*.json
bus.jpg
remote_ls.txt
OPUS_PROMPT.txt
OPUS_SYSTEM_PROMPT.md
SYSTEM_OPTIMIZED.md
reprocess_safe.bat
cleanup.py

# -- Root operational scratch notes -------------------------------------------
h264_upload.txt
missing_on_pod.txt
missing_tmp_local.txt
pod_videos_tmp.txt
upload_batch1.txt
upload_batch2.txt
.pod_transfer_*.txt

# -- Internal / experimental scaffolding --------------------------------------
scripts/vault_reorganize.py
scripts/runpod_optimize.sh
src/pipeline/gpu_dataframe.py
.claude/prompts/

# -- Backup files -------------------------------------------------------------
*.bak
*.orig
*.tmp
apps/portfolio-site/node_modules/
apps/portfolio-site/.next/
apps/portfolio-site/out/
