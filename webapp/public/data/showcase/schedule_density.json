 "methodology": {
  "density_classes": "b2b=prev game exactly 1 calendar day earlier (2nd leg); 3in4=>=3 games in the 4 calendar days ending on this game; 4in6=>=4 games in the 6 calendar days ending on it. Assigned to the TRAILING game of the window, within a season. OVERLAPPING lenses, NOT a partition (a b2b closing a cluster is also 3in4) -- counts not additive.",
  "baseline": "rested = games in NONE of the three classes (>= 2 days rest, no compression)",
  "production_metric": "per-36; composite = frozen Win-Score box composite (WEIGHTS_PER36, verbatim from box_value_index.py; Berri 2006)",
  "weights_per36": {
   "pts": 1.0,
   "reb": 1.0,
   "stl": 1.0,
   "blk": 0.7,
